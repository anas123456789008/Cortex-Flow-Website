# Local frontend configuration.
# Copy this file to .env and replace the placeholders.
# Never put service-role keys, database passwords, or JWT secrets here.

# Browser-side Supabase client
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# TanStack Start server-side Supabase client (same project/key for this setup)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# FastAPI backend base URL; no /chat suffix
VITE_API_BASE_URL=https://YOUR-RENDER-BACKEND.onrender.com
