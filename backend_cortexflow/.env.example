# Backend environment template. Copy to .env locally or configure in Render.
# Keep .env out of Git; never commit real passwords or API secrets.

# Supabase project used for login/authentication
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Legacy variable accepted by auth.py if your project still uses an anon key:
# SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Gemini API
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# Optional override for the model selected by llm.py
# GEMINI_MODEL=gemini-2.5-flash

# Structured PostgreSQL database — use the exact connection values from
# Supabase Dashboard > Connect. For a session pooler, use its displayed port.
STRUCTURED_DB_HOST=YOUR_POOLER_HOST
STRUCTURED_DB_PORT=5432
STRUCTURED_DB_NAME=postgres
STRUCTURED_DB_USER=YOUR_POOLER_USERNAME
STRUCTURED_DB_PASSWORD=YOUR_DATABASE_PASSWORD

# Legacy DB_* aliases are supported by db.py but are not required if using
# STRUCTURED_DB_* above.
# DB_HOST=YOUR_POOLER_HOST
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=YOUR_POOLER_USERNAME
# DB_PASSWORD=YOUR_DATABASE_PASSWORD

# Include your actual frontend origin(s), comma-separated.
CORS_ORIGINS=http://localhost:5173,https://YOUR-FRONTEND.vercel.app
